<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.delivery.backend.restaurant.dao.RestaurantDao">

    <resultMap id="shopResultMap" type="com.delivery.backend.restaurant.entity.ShopEntity">
        <id property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="addressRegion" column="address_region"/><result property="addressDetail" column="address_detail"/><result property="addressPhone" column="address_phone"/>
    </resultMap>

    <sql id="shopColumns">
        id, merchant_id, name, description, status, created_at, updated_at, deleted_at, address_region, address_detail, address_phone
    </sql>

    <sql id="shopFilters">
        WHERE deleted_at IS NULL
        <choose>
            <when test="mine">
                AND merchant_id = #{merchantId}
				<if test="status != null">
					AND status = #{status}
				</if>
            </when>
            <otherwise>
				<choose>
					<when test="status != null">
						AND status = #{status}
					</when>
					<otherwise>
						AND status = 'OPEN'
					</otherwise>
				</choose>
            </otherwise>
        </choose>
        <if test="keyword != null">
            AND name LIKE CONCAT('%', #{keyword}, '%')
        </if>
    </sql>

    <select id="findById" resultMap="shopResultMap">
        SELECT <include refid="shopColumns"/>
        FROM shops
        WHERE id = #{id}
          AND deleted_at IS NULL
    </select>

    <select id="findByMerchantAndName" resultMap="shopResultMap">
        SELECT <include refid="shopColumns"/>
        FROM shops
        WHERE merchant_id = #{merchantId}
          AND name = #{name}
          AND deleted_at IS NULL
    </select>

    <insert id="insert" parameterType="com.delivery.backend.restaurant.entity.ShopEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO shops (merchant_id, name, description, status)
        VALUES (#{merchantId}, #{name}, #{description}, #{status})
    </insert>

    <update id="update">
        UPDATE shops
        <set>
            <if test="nameSpecified">
                name = #{name},
            </if>
            <if test="descriptionSpecified">
                description = #{description},
            </if>
            <if test="statusSpecified">
                status = #{status},
            </if>
        </set>
        WHERE id = #{id}
          AND deleted_at IS NULL
    </update>
    <update id="updateAddress">UPDATE shops SET address_region=#{region}, address_detail=#{detail}, address_phone=#{phone} WHERE id=#{id} AND deleted_at IS NULL</update>

    <select id="list" resultMap="shopResultMap">
        SELECT <include refid="shopColumns"/>
        FROM shops
        <include refid="shopFilters"/>
        ORDER BY
        <choose>
            <when test="sortBy == 'name'">name</when>
            <otherwise>created_at</otherwise>
        </choose>
        <choose>
            <when test="sortOrder == 'asc'">ASC</when>
            <otherwise>DESC</otherwise>
        </choose>,
        id
        <choose>
            <when test="sortOrder == 'asc'">ASC</when>
            <otherwise>DESC</otherwise>
        </choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM shops
        <include refid="shopFilters"/>
    </select>

</mapper>
