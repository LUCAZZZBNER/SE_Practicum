<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.delivery.backend.image.dao.ImageDao">
 <resultMap id="image" type="com.delivery.backend.image.entity.ImageEntity">
  <id property="id" column="id"/><result property="merchantId" column="merchant_id"/><result property="url" column="url"/><result property="contentType" column="content_type"/>
  <result property="size" column="size"/><result property="content" column="content"/><result property="createdAt" column="created_at"/>
 </resultMap>
 <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO images(merchant_id,url,content_type,size,content) VALUES(#{merchantId},#{url},#{contentType},#{size},#{content})</insert>
 <update id="updateUrl">UPDATE images SET url=#{url} WHERE id=#{id}</update>
 <select id="findById" resultMap="image">SELECT id,merchant_id,url,content_type,size,content,created_at FROM images WHERE id=#{id}</select>
 <select id="findOwned" resultMap="image">SELECT id,merchant_id,url,content_type,size,content,created_at FROM images WHERE id=#{id} AND merchant_id=#{merchantId}</select>
</mapper>
