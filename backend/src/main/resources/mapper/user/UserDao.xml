<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.delivery.backend.user.dao.UserDao">

    <resultMap id="userResultMap" type="com.delivery.backend.user.entity.UserEntity">
        <id property="id" column="id"/>
        <result property="account" column="account"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="nickname" column="nickname"/>
        <result property="phone" column="phone"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="userColumns">
        id, account, password_hash, nickname, phone, status, created_at, updated_at
    </sql>

    <select id="findByAccount" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM users
        WHERE account = #{account}
    </select>

    <select id="findById" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM users
        WHERE id = #{id}
    </select>

    <select id="findByIdForUpdate" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM users
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <insert id="insert" parameterType="com.delivery.backend.user.entity.UserEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (account, password_hash, nickname, phone, status)
        VALUES (#{account}, #{passwordHash}, #{nickname}, #{phone}, #{status})
    </insert>

    <update id="updateProfile">
        UPDATE users
        <set>
            <if test="nicknameSpecified">
                nickname = #{nickname},
            </if>
            <if test="phoneSpecified">
                phone = #{phone},
            </if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
